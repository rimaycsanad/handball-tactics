# Optional: HTTPS URL serving the versioned catalogue manifest.
VITE_CATALOG_URL=
# Optional override for .firebaserc; used only by release scripts.
FIREBASE_PROJECT_ID=
FIREBASE_PREVIEW_CHANNEL=testers

# Firebase web app configuration (public identifiers, never Admin SDK credentials).
# Firebase Hosting also supports automatic /__/firebase/init.json configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local development only: demo project + Auth/Firestore emulators, never production.
VITE_FIREBASE_EMULATORS=false
